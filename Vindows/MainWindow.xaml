<Window x:Class="Vindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Vindows — окна по зонам" Height="760" Width="1220" MinHeight="620" MinWidth="1050"
                Icon="Vindows.ico" Background="{StaticResource AppBackgroundBrush}">
        <Border Background="{StaticResource WindowGradient}" CornerRadius="16" Margin="6">
            <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
          <WrapPanel>
                        <Button x:Name="ApplyBtn" Content="Расставить окна" Padding="10,4" Click="ApplyBtn_Click" FontWeight="Bold"/>
          </WrapPanel>
          <WrapPanel Margin="0,10,0,0">
            <CheckBox x:Name="ControlCheck" Content="Возвращать окна в зоны" VerticalAlignment="Center" Margin="0,0,20,6"/>
            <CheckBox x:Name="TopmostCheck" Content="Держать окна поверх остальных" VerticalAlignment="Center" Margin="0,0,20,6"
                      ToolTip="Работает независимо от возврата окон в зоны. При закрытии Vindows снимается включённый ею режим."/>
          </WrapPanel>
                    <TextBlock Text="Каждый запуск — с пустыми назначениями. Окна на другом мониторе возвращаются в исходную зону."
                     Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Мониторы" Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <ListBox x:Name="MonitorsList" SelectionChanged="MonitorsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="3,6"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Разбиение выбранного монитора" Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Колонки:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsBox" Grid.Column="1" Margin="4,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Строки:" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsBox" Grid.Column="3" Margin="4,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Зазор, px:" Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="GapBox" Grid.Column="5" Margin="4,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="ApplyGridBtn" Grid.Column="6" Content="Создать сетку" Margin="8,0,0,0" Padding="6,3" Click="ApplyGridBtn_Click"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Предпросмотр (рабочая область)" Grid.Row="1" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Перетащите окно на + в нужной ячейке — оно сразу привяжется и переместится." TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <Border Grid.Row="1" x:Name="PreviewFrame" CornerRadius="12" Background="#FF20242B">
                        <Canvas x:Name="PreviewCanvas" Background="#FF20242B"
                                AllowDrop="True"
                                SizeChanged="PreviewCanvas_SizeChanged"
                                MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                                MouseMove="PreviewCanvas_MouseMove"
                                MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp"
                                DragOver="PreviewCanvas_DragOver"
                                Drop="PreviewCanvas_Drop"/>
                    </Border>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Text="Перетаскивайте ручки на разделителях, чтобы менять пропорции областей."/>
                </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
</Window>
