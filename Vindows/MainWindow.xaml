<Window x:Class="Vindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Vindows — окна по зонам" Height="650" Width="1100" MinHeight="540" MinWidth="900"
        Icon="Vindows.ico" Background="{StaticResource AppBackgroundBrush}">
    <Border Background="{StaticResource WindowGradient}" CornerRadius="14" Margin="4">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель: расстановка, мониторы, сетка -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ApplyBtn" Content="Расставить окна" Padding="10,5" FontWeight="Bold"
                            Click="ApplyBtn_Click" VerticalAlignment="Center"/>

                    <ListBox x:Name="MonitorTabs" Grid.Column="1" Margin="8,0,0,0"
                             SelectionChanged="MonitorTabs_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="Transparent"
                             VerticalAlignment="Center">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="TabBorder" Background="#F7F8FA" BorderBrush="#D8D8DE"
                                                    BorderThickness="1.5" CornerRadius="9" Padding="7,5" MinWidth="105"
                                                    Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <Viewbox Width="19" Height="16" VerticalAlignment="Center">
                                                        <Canvas Width="19" Height="16">
                                                            <Rectangle Width="17" Height="11" RadiusX="1.5" RadiusY="1.5"
                                                                       Stroke="#8E8E93" StrokeThickness="1.2" Fill="White"/>
                                                            <Rectangle Canvas.Left="6" Canvas.Top="11" Width="6" Height="3"
                                                                       RadiusX="1" RadiusY="1" Fill="#8E8E93"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TabTitle}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="{Binding ResolutionText}" FontSize="10"
                                                                   Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#EEF5FF"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#99C7FF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabBorder" Property="Background" Value="#E8F2FF"/>
                                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="Разбиение выбранного монитора:" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock Text="Колонки:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsBox" Width="40" Margin="4,0,0,0" MaxLength="1" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Строки:" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsBox" Width="40" Margin="4,0,0,0" MaxLength="1" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Зазор, px:" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="GapBox" Width="40" Margin="4,0,0,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="ApplyGridBtn" Content="Создать сетку" Margin="8,0,0,0" Padding="8,5"
                                Click="ApplyGridBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Опции -->
            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                <WrapPanel>
                    <CheckBox x:Name="ControlCheck" Content="Возвращать окна в зоны" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <CheckBox x:Name="TopmostCheck" Content="Держать окна поверх остальных" VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="Работает независимо от возврата окон в зоны. При закрытии Vindows снимается включённый ею режим."/>
                </WrapPanel>
            </StackPanel>

            <!-- Предпросмотр на всю ширину -->
            <GroupBox Grid.Row="2" Header="Предпросмотр (рабочая область)" Margin="0,6,0,0"
                      Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Border x:Name="PreviewFrame" CornerRadius="10" Background="#FF20242B">
                        <Canvas x:Name="PreviewCanvas" Background="#FF20242B"
                                AllowDrop="True"
                                SizeChanged="PreviewCanvas_SizeChanged"
                                MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                                MouseMove="PreviewCanvas_MouseMove"
                                MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp"
                                DragOver="PreviewCanvas_DragOver"
                                Drop="PreviewCanvas_Drop"/>
                        </Border>
                </Grid>
            </GroupBox>

                    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,6,0,0"
                               Visibility="Collapsed"
                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
