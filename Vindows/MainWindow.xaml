<Window x:Class="Vindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="Root"
        Title="Vindows — управление окнами" Height="640" Width="1060"
        Icon="Vindows.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="RefreshBtn" Content="Обновить окна" Padding="10,4" Click="RefreshBtn_Click"/>
            <Button x:Name="ApplyBtn" Content="Расставить окна" Padding="10,4" Margin="8,0,0,0" FontWeight="Bold" Click="ApplyBtn_Click"/>
            <CheckBox x:Name="ControlCheck" Content="Контроль окон" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="SaveBtn" Content="Сохранить раскладку" Padding="10,4" Margin="8,0,0,0" Click="SaveBtn_Click"/>
            <Button x:Name="LoadBtn" Content="Загрузить раскладку" Padding="10,4" Margin="8,0,0,0" Click="LoadBtn_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Мониторы" Grid.Column="0">
                <ListBox x:Name="MonitorsList" SelectionChanged="MonitorsList_SelectionChanged"/>
            </GroupBox>

            <GroupBox Header="Разбиение выбранного монитора" Grid.Column="1" Margin="10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Колонки:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsBox" Grid.Column="1" Margin="4,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Строки:" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsBox" Grid.Column="3" Margin="4,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="Зазор, px:" Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="GapBox" Grid.Column="5" Margin="4,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="ApplyGridBtn" Grid.Column="6" Content="Применить сетку" Margin="12,0,0,0" Padding="8,3" Click="ApplyGridBtn_Click"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Приложения в областях:" Margin="0,10,0,4" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ZonesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding SizeText}" Foreground="Gray" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Windows, ElementName=Root}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="ProcessName"
                                                  SelectedValue="{Binding SelectedProcess}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <GroupBox Header="Предпросмотр (рабочая область)" Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Canvas x:Name="PreviewCanvas" Background="#FF20242B"
                            SizeChanged="PreviewCanvas_SizeChanged"
                            MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                            MouseMove="PreviewCanvas_MouseMove"
                            MouseLeftButtonUp="PreviewCanvas_MouseLeftButtonUp"/>
                    <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                               Text="Перетаскивайте ручки на разделителях, чтобы менять пропорции областей."/>
                </Grid>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray"/>
    </Grid>
</Window>
